# Set this to a Stripe test secret key for local development.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_chars

# SMTP settings used for email verification and password reset.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
SMTP_SENDER_EMAIL=no-reply@example.com

# Cloudflare R2 audio storage. Keep credentials server-side only.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=sharp-sharp-uploads
R2_ENDPOINT=https://replace_me.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://replace_me.example.com
MAX_UPLOAD_MB=50

# Local Docker PostgreSQL. Change DATABASE_URL to Neon in production.
POSTGRES_DB=sharp_sharp_delivery
POSTGRES_USER=sharp_sharp
POSTGRES_PASSWORD=sharp_sharp_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sharp_sharp:sharp_sharp_dev@localhost:5432/sharp_sharp_delivery

# Comma-separated origins. Keep '*' only for local development.
CORS_ORIGINS=*
